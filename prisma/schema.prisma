generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

enum UserRole {
  ADMIN_LSP
  ASESOR
  ASESI_SISWA
}

enum AssessmentStatus {
  TERDAFTAR
  PROSES_NILAI
  KOMPETEN
  BELUM_KOMPETEN
}

model User {
  id              Int                 @id @default(autoincrement())
  username        String              @unique
  password        String
  nama            String
  role            UserRole
  kelas           String?
  nisn            String?             @unique
  noRegAsesor     String?             @unique
  studentSessions AssessmentSession[] @relation("StudentSessions")
  assessorSessions AssessmentSession[] @relation("AssessorSessions")
}

model CertificationScheme {
  id        Int              @id @default(autoincrement())
  kodeSkema String           @unique
  namaSkema String
  jurusan   String
  units     CompetencyUnit[]
  sessions  AssessmentSession[]
}

model CompetencyUnit {
  id          Int                @id @default(autoincrement())
  schemeId    Int
  scheme      CertificationScheme @relation(fields: [schemeId], references: [id], onDelete: Cascade)
  kodeUnit    String
  judulUnit   String
  deskripsi   String
  results     CompetencyResult[]
  selfAssessments SelfAssessment[]

  @@unique([schemeId, kodeUnit])
}

model AssessmentSession {
  id                 Int                  @id @default(autoincrement())
  schemeId           Int
  scheme             CertificationScheme @relation(fields: [schemeId], references: [id])
  studentId          Int
  student            User                 @relation("StudentSessions", fields: [studentId], references: [id])
  assessorId         Int?
  assessor           User?                @relation("AssessorSessions", fields: [assessorId], references: [id])
  tglUjian           DateTime             @default(now())
  statusAsesmen      AssessmentStatus     @default(TERDAFTAR)
  rekomendasiAsesor  String?
  evidence           PortfolioEvidence[]
  results            CompetencyResult[]
  selfAssessments    SelfAssessment[]

  @@unique([schemeId, studentId])
}

model PortfolioEvidence {
  id             Int              @id @default(autoincrement())
  sessionId      Int
  session        AssessmentSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  judulKarya     String
  linkGithub     String
  linkDemoWeb    String
  fileDokumenUrl String?
  catatanAsesi   String?
  createdAt      DateTime         @default(now())
}

model CompetencyResult {
  id               Int              @id @default(autoincrement())
  sessionId        Int
  session          AssessmentSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  unitId           Int
  unit             CompetencyUnit    @relation(fields: [unitId], references: [id])
  isCompetent      Boolean?
  catatanObservasi String?

  @@unique([sessionId, unitId])
}

model SelfAssessment {
  id          Int              @id @default(autoincrement())
  sessionId   Int
  session     AssessmentSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  unitId      Int
  unit        CompetencyUnit    @relation(fields: [unitId], references: [id])
  isCompetent Boolean
  catatan     String?

  @@unique([sessionId, unitId])
}