<!doctype html>
<html lang="id">
<head><meta charset="utf-8"><meta name="viewport" content="width=device-width, initial-scale=1"><title>Stelar Institute | <%= title.replace(' | LSP-P1', '') %></title><meta name="description" content="Sistem Asesmen UKK dan LSP-P1"><script src="https://cdn.tailwindcss.com"></script><link href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600;700&family=Manrope:wght@500;600;700;800&display=swap" rel="stylesheet"><link rel="stylesheet" href="/css/style.css"></head>
<body class="login-body">
  <main class="login-layout">
    <section class="login-aside"><a href="/login" class="identity light"><img class="telkom-schools-logo" src="/images/telkom-schools-logo.png" alt="Telkom Schools"><span><strong>Stelar Institute</strong><small>SISTEM ASESMEN UKK DAN LSP-P1</small></span></a><div class="login-message"><span class="eyebrow">SISTEM ASESMEN DIGITAL</span><h1>Kompetensi nyata.<br><em>Bukti terukur.</em></h1><p>Ruang kerja terpadu untuk asesmen UKK, validasi portofolio, dan penerbitan hasil sertifikasi.</p><div class="login-aside-rule"></div><span class="login-aside-foot">LEMBAGA SERTIFIKASI PROFESI PIHAK PERTAMA</span></div><div class="aside-grid" aria-hidden="true"></div></section>
    <section class="login-main"><div class="login-card"><div class="eyebrow">PORTAL PENGGUNA</div><h2>Selamat datang</h2><p>Masuk dengan akun yang terdaftar di LSP.</p>
      <% if (notice) { %><div class="login-notice"><%= notice %></div><% } %>
      <% if (error) { %><div class="login-error"><%= error %></div><% } %>
      <form action="/login" method="post" class="login-form"><label>Username<input required name="username" id="username" autocomplete="username" placeholder="Masukkan username"></label><label>Password<input required type="password" name="password" id="password" autocomplete="current-password" placeholder="Masukkan password"></label><button class="button primary login-submit">Masuk ke portal <span>→</span></button></form>
      <details class="student-register"><summary>Daftar akun asesi siswa <span>+</span></summary><form action="/register" method="post" class="login-form register-form"><label>Nama lengkap<input required name="nama" placeholder="Nama sesuai identitas"></label><label>ID / NISN<input required name="nisn" placeholder="Nomor induk siswa"></label><label>Kelas / jurusan<select required name="kelas"><option value="">Pilih kelas</option><option>Rekayasa Perangkat Lunak</option><option>Teknik Komputer dan Jaringan</option><option>Teknik Jaringan Akses Telekomunikasi</option><option>Animasi</option></select></label><label>Username<input required name="username" autocomplete="username" placeholder="Buat username"></label><label>Password<input required type="password" name="password" minlength="8" autocomplete="new-password" placeholder="Minimal 8 karakter"></label><button class="button secondary login-submit">Buat akun siswa <span>→</span></button></form></details>
      <div class="demo-section"><div class="demo-title"><span>AKSES DEMO</span><span>Password: password123</span></div><div class="demo-buttons"><button type="button" onclick="fillDemo('adminlsp')"><span class="demo-icon admin-icon">A</span><span><strong>Admin LSP</strong><small>Kelola sertifikasi</small></span><span class="demo-arrow">↗</span></button><button type="button" onclick="fillDemo('asesor')"><span class="demo-icon assessor-icon">P</span><span><strong>Asesor</strong><small>Nilai kompetensi</small></span><span class="demo-arrow">↗</span></button><button type="button" onclick="fillDemo('asesisiswa')"><span class="demo-icon student-icon">S</span><span><strong>Asesi siswa</strong><small>Portofolio & hasil</small></span><span class="demo-arrow">↗</span></button></div></div>
      <div class="login-legal">UKK & PORTOFOLIO DIGITAL <span>·</span> LSP-P1 SMK TELKOM</div>
    </div></section>
  </main>
<script>function fillDemo(username){document.getElementById('username').value=username;document.getElementById('password').value='password123';document.getElementById('password').focus()}</script>
</body></html>