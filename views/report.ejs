<!doctype html>
<html lang="id"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width, initial-scale=1"><title><%= title %></title><link rel="stylesheet" href="/css/style.css"></head>
<body class="report-body"><main class="report-page"><div class="report-actions"><a href="javascript:history.back()">← Kembali</a><button class="button primary" onclick="window.print()">Cetak / Simpan PDF</button></div>
  <header class="report-header"><div class="report-seal">LSP<br><small>P1</small></div><div><span>LEMBAGA SERTIFIKASI PROFESI PIHAK PERTAMA</span><h1>BERITA ACARA ASESMEN KOMPETENSI</h1><p>SMK Telkom Lampung · Dokumen verifikasi hasil uji</p></div><div class="report-code"><small>NO. DOKUMEN</small><strong>UKK/<%= assessment.scheme.kodeSkema %>/<%= assessment.id %></strong></div></header>
  <div class="report-divider"></div><section class="report-section"><h2>Identitas asesmen</h2><dl class="report-data"><div><dt>Nama asesi</dt><dd><%= assessment.student.nama %></dd></div><div><dt>NISN</dt><dd><%= assessment.student.nisn || '-' %></dd></div><div><dt>Skema sertifikasi</dt><dd><%= assessment.scheme.namaSkema %></dd></div><div><dt>Kode skema</dt><dd><%= assessment.scheme.kodeSkema %></dd></div><div><dt>Asesor penguji</dt><dd><%= assessment.assessor ? assessment.assessor.nama : '-' %></dd></div><div><dt>No. registrasi asesor</dt><dd><%= assessment.assessor?.noRegAsesor || '-' %></dd></div><div><dt>Tanggal asesmen</dt><dd><%= new Date(assessment.tglUjian).toLocaleDateString('id-ID', { day: '2-digit', month: 'long', year: 'numeric' }) %></dd></div><div><dt>Status akhir</dt><dd><span class="badge <%= assessment.statusAsesmen.toLowerCase() %>"><%= assessment.statusAsesmen.replaceAll('_', ' ') %></span></dd></div></dl></section>
  <section class="report-section"><h2>Rekap unit kompetensi</h2><table class="report-table"><thead><tr><th>No.</th><th>Kode unit</th><th>Judul unit kompetensi</th><th>Keputusan</th><th>Catatan observasi</th></tr></thead><tbody><% assessment.scheme.units.forEach((unit, index) => { const result = assessment.results.find((row) => row.unitId === unit.id); %><tr><td><%= index + 1 %></td><td><%= unit.kodeUnit %></td><td><%= unit.judulUnit %></td><td><strong><%= result?.isCompetent === true ? 'KOMPETEN' : result?.isCompetent === false ? 'BELUM KOMPETEN' : 'BELUM DINILAI' %></strong></td><td><%= result?.catatanObservasi || '-' %></td></tr><% }) %></tbody></table></section>
  <section class="report-section"><h2>Bukti portofolio</h2><% assessment.evidence.forEach((evidence) => { %><div class="report-evidence"><strong><%= evidence.judulKarya %></strong><span>GitHub: <%= evidence.linkGithub %></span><span>Demo: <%= evidence.linkDemoWeb %></span></div><% }) %><% if (!assessment.evidence.length) { %><p>- Tidak ada bukti terlampir -</p><% } %></section>
  <section class="recommendation-report"><h2>Rekomendasi dan catatan asesor</h2><p><%= assessment.rekomendasiAsesor || 'Belum ada rekomendasi akhir.' %></p></section>
  <div class="signature-grid"><div><p>Asesi</p><div class="signature-space"></div><strong><%= assessment.student.nama %></strong><small><%= assessment.student.nisn || 'NISN -' %></small></div><div><p>Asesor Kompetensi</p><div class="signature-space"></div><strong><%= assessment.assessor?.nama || '-' %></strong><small>No. Reg: <%= assessment.assessor?.noRegAsesor || '-' %></small></div></div>
  <footer class="report-footer">Dokumen ini diterbitkan melalui Sistem Asesmen UKK & Portofolio LSP-P1 SMK Telkom Lampung.</footer>
</main></body></html>